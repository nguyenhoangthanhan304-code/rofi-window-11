@lru_cache(maxsize=4096)
def accent_for(name):
    h = int(hashlib.md5(name.encode("utf-8")).hexdigest()[:4], 16) % 360 / 360.0
    return (QColor.fromHslF(h, 0.68, 0.60), QColor.fromHslF((h + 0.10) % 1.0, 0.72, 0.58))


class App:
    kind = "app"
    parent = ""

    def __init__(self, name, command, description="", category="Application", icon_hint=None):
        self.name = name
        self.command = command
        self.description = description or describe(name)
        self.category = category
        self.icon_hint = icon_hint
        self.hay = f"{name} {category} {self.description}".lower()
        self.icon_key = ("app", name.lower())
        self._icon = None
        self._icon_loaded = False

    @property
    def icon(self):
        if not self._icon_loaded:
            self._icon_loaded = True
            self._icon = self._load_icon()
        return self._icon

    def _load_icon(self):
        global _provider
        try:
            ic = None
            if sys.platform.startswith("linux"):
                h = self.icon_hint
                if h:
                    ic = QIcon(h) if os.path.isabs(h) and os.path.exists(h) else QIcon.fromTheme(h)
            else:
                if self.command.lower().startswith("shell:"):
                    return None          # Store / UWP app: no file to take an icon from -> coloured letter icon
                if _provider is None:
                    _provider = QFileIconProvider()
                ic = _provider.icon(QFileInfo(self.icon_hint or self.command))
            if ic is not None and not ic.isNull():
                pm = ic.pixmap(QSize(64, 64))
                if not pm.isNull():
                    return pm
        except Exception:
            pass
        return None


_provider = None


class FileItem:
    kind = "file"
    __slots__ = ("path", "name", "name_l", "parent", "mtime", "size", "is_dir", "ext", "icon_key")
    PER_FILE_ICON = {".exe", ".lnk", ".ico", ".url", ".msi", ".appref-ms"}

    def __init__(self, path, mtime, size, is_dir):
        self.path = path
        self.name = os.path.basename(path)
        self.name_l = self.name.lower()
        par = os.path.dirname(path)
        self.parent = ("~" + par[len(HOME):]) if par.startswith(HOME) else par
        self.mtime = mtime
        self.size = size
        self.is_dir = is_dir
        self.ext = "" if is_dir else os.path.splitext(self.name_l)[1]
        if is_dir:
            self.icon_key = ("dir",)
        elif self.ext in self.PER_FILE_ICON:
            self.icon_key = ("file", path)
        else:
            self.icon_key = ("ext", self.ext)


# icon cache:  key -> QPixmap | None (= "this item has no icon, draw the letter icon").
# A key that is NOT in the dict has not been loaded yet.
_icon_cache = {}


def item_icon(item):
    """Build + cache the 56px icon.  This can be slow (it asks the OS shell), so it is only ever
    called from the idle icon loader or the pre-load before the window opens - never from paintEvent."""
    key = item.icon_key
    if key in _icon_cache:
        return _icon_cache[key]
    pm = None
    try:
        if item.kind == "file":
            global _provider
            if _provider is None:
                _provider = QFileIconProvider()
            if item.is_dir:
                ic = _provider.icon(QFileIconProvider.IconType.Folder)
            else:
                ic = _provider.icon(QFileInfo(item.path))
            pm = ic.pixmap(QSize(56, 56))
        else:
            pm = item.icon
        if pm is not None and not pm.isNull():
            pm = pm.scaled(56, 56, Qt.AspectRatioMode.KeepAspectRatio,
                           Qt.TransformationMode.SmoothTransformation)
        else:
            pm = None
    except Exception:
        pm = None
    _icon_cache[key] = pm
    return pm


def draw_fallback_icon(p, name, rect, radius=8):
    c1, c2 = accent_for(name.lower() if name else "?")
    g = QLinearGradient(rect.topLeft(), rect.bottomRight())
    g.setColorAt(0, c1)
    g.setColorAt(1, c2)
    path = QPainterPath()
    path.addRoundedRect(rect, radius, radius)
    p.fillPath(path, g)
    f = QFont(p.font())
    f.setBold(True)
    f.setPixelSize(int(rect.height() * 0.46))
    p.setFont(f)
    p.setPen(QColor(255, 255, 255, 235))
    p.drawText(rect, Qt.AlignmentFlag.AlignCenter, (name[:1] or "?").upper())


