def clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))


def with_alpha(c, a):
    c = QColor(c)
    c.setAlpha(int(clamp(a, 0, 255)))
    return c


def lerp_color(a, b, t):
    t = clamp(t)
    return QColor(int(a.red() + (b.red() - a.red()) * t),
                  int(a.green() + (b.green() - a.green()) * t),
                  int(a.blue() + (b.blue() - a.blue()) * t),
                  int(a.alpha() + (b.alpha() - a.alpha()) * t))


def ease_out_cubic(t):
    return 1 - (1 - t) ** 3


def ease_out_back(t, s=2.4):
    t = t - 1
    return 1 + (s + 1) * t ** 3 + s * t ** 2


def mono_font(px, weight=QFont.Weight.Normal):
    f = QFont()
    f.setFamilies(MONO_FAMILIES)
    f.setPixelSize(px)
    f.setWeight(weight)
    return f


def clean_path(text):
    t = (text or "").strip().strip('"').strip("'").strip()
    if t.lower().startswith("file:"):
        t = QUrl(t).toLocalFile() or t
    return t


def resolve_path(text):
    return os.path.expanduser(clean_path(text))


def valid_image(text):
    p = resolve_path(text)
    try:
        return bool(p) and os.path.isfile(p) and QImageReader(p).canRead()
    except Exception:
        return False


class Theme:
    """t = 0 dark ... 1 light (animated)."""
    def __init__(self, dark=True):
        self.t = 0.0 if dark else 1.0

    def mix(self, dark, light):
        return lerp_color(dark, light, self.t)


