    # --- theme / accent ----------------------------------------------------
    def toggle_theme(self):
        dark = not CFG["dark"]
        CFG["dark"] = dark
        save_config()
        self.btn_theme.set_kind("moon" if dark else "sun")
        self.theme_anim.stop()
        self.theme_anim.setStartValue(self.theme.t)
        self.theme_anim.setEndValue(0.0 if dark else 1.0)
        self.theme_anim.start()
        self.search.setFocus()

    def _set_theme(self, v):
        self.theme.t = float(v)
        self.update()
        self.list.update()
        self.sortbar.update()
        self.pathbar.update()

    def set_accent(self, c):
        self.accent = c
        for b in self.buttons:
            b.set_accent(c)
        self.list.accent = c
        self.sortbar.accent = c
        self.pathbar.accent = c
        self.search.setStyleSheet(search_qss(c))
        self.settings.restyle(c)
        self.list.update()
        self.sortbar.update()
        self.pathbar.update()
        self.update()

    # --- banner change animation -------------------------------------------
    def _set_bt(self, v):
        self.bt = float(v)
        self.update(0, 0, CARD_W, HEADER_H)

    def _banner_done(self):
        self.old_banner = None
        self.bt = 1.0
        self.update()

    def set_banner(self, pm, animate):
        if animate and self.banner is not None:
            self.old_banner = self.banner
            self.banner = pm
            self.bt = 0.0
            self.banner_anim.stop()
            self.banner_anim.start()
        else:
            self.banner = pm
            self.old_banner = None
            self.bt = 1.0
            self.update()

    def _paint_banner(self, p, hr):
        old, t = self.old_banner, self.bt
        if old is None or t >= 1.0:
            p.drawPixmap(hr.toRect(), self.banner)
            return
        c = hr.center()
        # old picture drifts away and dims
        p.save()
        p.translate(c)
        s = 1 + 0.05 * t
        p.scale(s, s)
        p.translate(-c)
        p.drawPixmap(hr.toRect(), old)
        p.restore()
        p.fillRect(hr, QColor(0, 0, 0, int(70 * t)))
        # new picture slides in behind a slanted, glowing wipe edge and zooms down into place
        slant = 120.0
        x = -slant + t * (CARD_W + 2 * slant)
        a, b = QPointF(x + slant, 0), QPointF(x - slant, HEADER_H)
        path = QPainterPath()
        path.addPolygon(QPolygonF([QPointF(0, 0), a, b, QPointF(0, HEADER_H)]))
        path.closeSubpath()
        p.save()
        p.setClipPath(path, Qt.ClipOperation.IntersectClip)
        p.translate(c)
        s = 1 + 0.2 * (1 - t)
        p.scale(s, s)
        p.translate(-c)
        p.drawPixmap(hr.toRect(), self.banner)
        p.restore()
        fade = math.sin(math.pi * t)
        for col, w, al in ((self.accent, 18, 40), (self.accent, 9, 95), (QColor(255, 255, 255), 3, 240)):
            p.setPen(QPen(with_alpha(col, al * fade), w, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            p.drawLine(a, b)
        p.fillRect(hr, QColor(255, 255, 255, int(45 * fade)))

    def apply_settings(self, changed):
        if "banner" in changed:
            key = CFG["banner_image"]
            self.set_banner(build_banner(), key != self._banner_key)    # animate only when the picture changes
            self._banner_key = key
        if "accent" in changed or ("banner" in changed and str(CFG["accent"]).lower() == "auto"):
            self.set_accent(resolve_accent(self.banner))
        if "bg" in changed:
            self.bg_changed.emit()
        if "roots" in changed and self.index_state != "idle":
            self.start_indexing()

    # --- modes -------------------------------------------------------------
    def set_mode(self, m):
        if m != self.mode:
            self.list.begin_transition(1 if m == "files" else -1)
        self.mode = m
        self.btn_files.set_active(m == "files")
        self.btn_apps.set_active(m == "apps")
        self.sortbar.slide(m == "files")
        self.pathbar.slide(m == "files" and bool(self.nav_stack))
        self.search.setPlaceholderText("Search files" if m == "files" else "Search apps")
        if m == "files" and self.index_state == "idle":
            self.start_indexing()
        self.apply_filter()
        self.search.setFocus()

    def cycle_mode(self):
        self.set_mode("files" if self.mode == "apps" else "apps")

    # --- Store / UWP apps (found in the background) ------------------------
    def start_app_scan(self):
        if not sys.platform.startswith("win") or self.app_scanner is not None:
            return
        self.app_scanner = AppScanner()
        self.app_scanner.found.connect(self.merge_start_apps)
        self.app_scanner.start(QThread.Priority.LowPriority)

    def merge_start_apps(self, found):
        known = {a.name.lower() for a in self.apps}
        new = []
        for name, appid in found:
            low = name.lower()
            if _SKIP_APP_RE.search(name) or low in known:
                continue
            known.add(low)
            new.append(make_start_app(name, appid))
        if not new:
            return
        self.apps = sorted(self.apps + new, key=lambda a: a.name.casefold())
        q = self.search.text().strip()
        if self.mode == "apps" and not q.startswith((">", "?")):
            self.list.replace_items(self._app_items(q))      # keeps your scroll position + selection

    # --- file index --------------------------------------------------------
    def start_indexing(self):
        roots = [HOME] + [resolve_path(r) for r in CFG["extra_roots"] if os.path.isdir(resolve_path(r))]
        if self.indexer is not None:
            self.indexer.stop()
            self._old_indexers.append(self.indexer)
        self.index_state = "loading"
        self.index_count = 0
        self.indexer = FileIndexer(roots)
        self.indexer.loaded.connect(self._files_loaded)
        self.indexer.done.connect(self._files_done)
        self.indexer.progress.connect(self._files_progress)
        self.indexer.start(QThread.Priority.LowestPriority)

    def _files_loaded(self, items):
        if self.index_state != "ready" and not self.files:
            self.files = items
            self._sorted_key = None
            if self.mode == "files":
                self.apply_filter()

    def _files_done(self, items):
        self.files = items
        self.index_state = "ready"
        self._sorted_key = None
        if self.mode == "files":
            self.apply_filter()

    def _files_progress(self, n):
        self.index_count = n
        if self.mode == "files" and not self.files_sorted:
            self.sortbar.set_status(f"indexing\u2026 {n:,}")

    def _sort_getter(self):
        return {"name": attrgetter("name_l"), "date": attrgetter("mtime"),
                "size": attrgetter("size"), "type": attrgetter("ext", "name_l")}[CFG["file_sort"]]

    def _ensure_sorted(self):
        """Sorting 100k+ files takes a moment, so it only happens when the Files view actually needs it
        (before it was done on the UI thread every time an index finished, even in Apps mode)."""
        key = (CFG["file_sort"], bool(CFG["file_sort_asc"]), id(self.files), len(self.files))
        if key != self._sorted_key:
            self.files_sorted = sorted(self.files, key=self._sort_getter(), reverse=not CFG["file_sort_asc"])
            self._sorted_key = key

    def _resort(self):
        self._sorted_key = None
        if self.nav_stack:
            self._resort_dir()

    def _resort_dir(self):
        g, rev = self._sort_getter(), not CFG["file_sort_asc"]
        dirs = sorted([i for i in self.dir_items if i.is_dir], key=g, reverse=rev)
        files = sorted([i for i in self.dir_items if not i.is_dir], key=g, reverse=rev)
        self.dir_sorted = dirs + files          # folders first

    # --- folders -----------------------------------------------------------
    def _show_folder(self, direction=1):
        path = self.nav_stack[-1]
        self.dir_items = list_dir(path)
        self._resort_dir()
        self.pathbar.set_path(path, direction)
        self.pathbar.slide(True)
        self.search.blockSignals(True)
        self.search.setText("")
        self.search.blockSignals(False)
        self.apply_filter()

    def enter_folder(self, path):
        self.list.begin_transition(1)               # old list slides left, new rows fly in from the right
        self.nav_stack.append(path)
        self._show_folder(1)

    def exit_folder(self):
        if not self.nav_stack:
            return
        self.list.begin_transition(-1)              # mirror of entering
        self.nav_stack.pop()
        if self.nav_stack:
            self._show_folder(-1)
        else:
            self.pathbar.slide(False)
            self.search.blockSignals(True)
            self.search.setText("")
            self.search.blockSignals(False)
            self.apply_filter()
        self.search.setFocus()

    def _sort_changed(self, key, asc):
        CFG["file_sort"], CFG["file_sort_asc"] = key, asc
        save_config()
        self._resort()
        self.list.begin_transition(0)               # rows fade / drop in again in the new order
        self.apply_filter()

    def shutdown(self):
        if self.app_scanner is not None:
            try:
                self.app_scanner.stop()
                self.app_scanner.wait(1500)
            except Exception:
                pass
        for ix in ([self.indexer] if self.indexer else []) + self._old_indexers:
            try:
                ix.stop()
                ix.wait(1200)
            except Exception:
                pass

    # --- filtering ---------------------------------------------------------
    def _app_items(self, q):
        ql = q.lower()
        return [a for a in self.apps if not ql or ql in a.hay]

    def apply_filter(self):
        q = self.search.text().strip()
        if self.mode == "files":
            if not self.nav_stack:
                self._ensure_sorted()
            src = self.dir_sorted if self.nav_stack else self.files_sorted
            toks = q.lower().split()
            if not toks:
                items = src
            elif len(toks) == 1:
                t = toks[0]
                items = [it for it in src if t in it.name_l]
            else:
                items = [it for it in src if all(t in it.name_l for t in toks)]
            if not src and self.nav_stack:
                self.list.message = "This folder is empty"
            elif not src:
                self.list.message = ("Indexing your files\u2026" if self.index_state == "loading"
                                     else "No files found")
            else:
                self.list.message = "No matching files"
            self.list.set_items(items)
            if self.index_state == "loading" and not src and not self.nav_stack:
                self.sortbar.set_status(f"indexing\u2026 {self.index_count:,}")
            elif toks:
                self.sortbar.set_status(f"{len(items):,} of {len(src):,}")
            else:
                self.sortbar.set_status(f"{len(src):,} items" + (" \u00b7 updating\u2026" if self.index_state == "loading" and not self.nav_stack else ""))
            return

        if q.startswith(">"):
            cmd = q[1:].strip()
            self.list.message = f"\u21b5  Run  {cmd}" if cmd else "Type a command after  >"
            self.list.set_items([])
        elif q.startswith("?"):
            words = q[1:].strip()
            self.list.message = f"\u21b5  Search the web for  {words}" if words else "Type something after  ?"
            self.list.set_items([])
        else:
            items = self._app_items(q)
            self.list.message = "No apps found"
            self.list.set_items(items)

    # --- launching ---------------------------------------------------------
    def on_enter(self):
        q = self.search.text().strip()
        if self.mode == "apps" and q.startswith(">"):
            if q[1:].strip():
                run_command(q[1:].strip())
                self.launched.emit()
            return
        if self.mode == "apps" and q.startswith("?"):
            if q[1:].strip():
                webbrowser.open("https://www.google.com/search?q=" + quote_plus(q[1:].strip()))
                self.launched.emit()
            return
        cur = self.list.current()
        if cur is not None:
            self.launch_item(cur)

    def on_reveal(self):
        cur = self.list.current()
        if cur is not None and cur.kind == "file":
            reveal_path(cur.path)
            self.launched.emit()

    def launch_item(self, item):
        if item.kind == "file":
            if item.is_dir:
                self.enter_folder(item.path)        # click into the folder
                return
            open_path(item.path)
        else:
            launch_app(item)
        self.launched.emit()

    def on_escape(self):
        if self.settings.is_open():
            self.settings.close_anim()
            return True
        return False

    # --- painting ----------------------------------------------------------
    def paintEvent(self, e):
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform)
        r = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        card = QPainterPath()
        card.addRoundedRect(r, CARD_RADIUS, CARD_RADIUS)

        p.save()
        p.setClipPath(card)
        p.fillRect(r, self.theme.mix(*LIST_BG))                    # list area

        # banner (zooms out while popping in).  IntersectClip keeps the rounded top corners!
        hr = QRectF(0, 0, CARD_W, HEADER_H)
        z = 1 + 0.25 * (1 - ease_out_cubic(clamp(self.seq)))
        p.save()
        p.setClipRect(hr, Qt.ClipOperation.IntersectClip)
        p.translate(hr.center())
        p.scale(z, z)
        p.translate(-hr.center())
        self._paint_banner(p, hr)
        p.restore()
        p.fillRect(hr, QColor(0, 0, 0, 22))

        # light sweep
        sh = clamp((self.seq - 0.15) / 0.6)
        if 0 < sh < 1:
            x = -220 + ease_out_cubic(sh) * (CARD_W + 440)
            poly = QPolygonF([QPointF(x - 40 + 90, 0), QPointF(x + 40 + 90, 0),
                              QPointF(x + 40 - 90, CARD_H), QPointF(x - 40 - 90, CARD_H)])
            sg = QLinearGradient(x - 60, 0, x + 60, 0)
            sg.setColorAt(0, QColor(255, 255, 255, 0))
            sg.setColorAt(0.5, QColor(255, 255, 255, 80))
            sg.setColorAt(1, QColor(255, 255, 255, 0))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(sg)
            p.drawPolygon(poly)
        p.restore()

        # accent glow that fades once the menu has landed
        glow = (1 - clamp(self.seq / 0.9)) ** 1.5
        p.setBrush(Qt.BrushStyle.NoBrush)
        if glow > 0.01:
            for i in range(1, 7):
                p.setPen(QPen(with_alpha(self.accent, 90 * glow / i), i * 2.4))
                p.drawPath(card)
        p.setPen(QPen(self.theme.mix(*EDGE), 1.2))
        p.drawPath(card)


# ----------------------------------------------------------------------------
# Background item (wallpaper + vignette + shadow + border) with parallax
# ----------------------------------------------------------------------------
class BgItem(QGraphicsItem):
    def __init__(self, w, h, card_rect, parent=None):
        super().__init__(parent)
        self.w, self.h = w, h
        self.sx = self.sy = 0.0
        self.bg = QPixmap()
        self.old_bg = None
        self.t = 1.0
        self.setAcceptedMouseButtons(Qt.MouseButton.NoButton)
        self.clip = QPainterPath()
        self.clip.addRoundedRect(QRectF(1, 1, w - 2, h - 2), PANEL_RADIUS, PANEL_RADIUS)

        img = QImage(w, h, QImage.Format.Format_ARGB32_Premultiplied)
        img.fill(Qt.GlobalColor.transparent)
        p = QPainter(img)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setClipPath(self.clip)
        vg = QRadialGradient(QPointF(w / 2, h / 2), max(w, h) * 0.7)
        vg.setColorAt(0.6, QColor(0, 0, 0, 0))
        vg.setColorAt(1.0, QColor(0, 0, 0, 90))
        p.fillRect(QRectF(0, 0, w, h), vg)
        for i in range(16, 0, -1):                                  # soft shadow under the card
            sp = QPainterPath()
            sp.addRoundedRect(card_rect.adjusted(-i * 3, -i * 3 + 14, i * 3, i * 3 + 14),
                              CARD_RADIUS + i * 3, CARD_RADIUS + i * 3)
            p.fillPath(sp, QColor(0, 0, 0, 7))
        p.setClipping(False)
        bg = QLinearGradient(0, 0, w, h)
        bg.setColorAt(0, QColor(255, 255, 255, 120))
        bg.setColorAt(0.5, QColor(255, 255, 255, 25))
        bg.setColorAt(1, QColor(255, 255, 255, 60))
        p.setPen(QPen(bg, 1.6))
        p.drawPath(self.clip)
        p.end()
        self.overlay = QPixmap.fromImage(img)

    def boundingRect(self):
        return QRectF(0, 0, self.w, self.h)

    def set_bg(self, pm, animate=False):
        if animate and not self.bg.isNull():
            self.old_bg = self.bg
            self.t = 0.0
        else:
            self.old_bg = None
            self.t = 1.0
        self.bg = pm
        self.update()

    def paint(self, p, option, widget=None):
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform)
        p.setClipPath(self.clip)
        pos = QPointF(-BG_PAD + self.sx, -BG_PAD + self.sy)
        if self.old_bg is None or self.t >= 1.0:
            p.drawPixmap(pos, self.bg)
        else:
            # new wallpaper blooms outward from the centre (zooming down into place) with a glowing ring
            t = self.t
            p.drawPixmap(pos, self.old_bg)
            c = QPointF(self.w / 2, self.h / 2)
            r = math.hypot(self.w, self.h) / 2 * 1.08 * t
            circ = QPainterPath()
            circ.addEllipse(c, r, r)
            p.save()
            p.setClipPath(circ, Qt.ClipOperation.IntersectClip)
            s = 1.12 - 0.12 * t
            p.translate(c)
            p.scale(s, s)
            p.translate(-c)
            p.drawPixmap(pos, self.bg)
            p.restore()
            fade = math.sin(math.pi * t)
            p.setBrush(Qt.BrushStyle.NoBrush)
            for w, al in ((28, 25), (12, 70), (4, 210)):
                p.setPen(QPen(QColor(255, 255, 255, int(al * fade)), w))
                p.drawEllipse(c, r, r)
        p.setClipping(False)
        p.drawPixmap(0, 0, self.overlay)


# ----------------------------------------------------------------------------
# Window: transparent view holding the tilting surface (background + card)
# ----------------------------------------------------------------------------
class LauncherView(QGraphicsView):
    def __init__(self, apps):
        super().__init__()
        self.setWindowTitle("Ohio")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setStyleSheet("background:transparent;border:none;")
        self.viewport().setAutoFillBackground(False)
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform
                            | QPainter.RenderHint.TextAntialiasing)
        # The window is big (the tilt needs the room) and transparent.  Repainting ALL of it for every scroll
        # tick / hover / caret blink was the main source of lag, so only the changed part is repainted now.
        self.setViewportUpdateMode(QGraphicsView.ViewportUpdateMode.BoundingRectViewportUpdate
                                   if PARTIAL_REPAINT else QGraphicsView.ViewportUpdateMode.FullViewportUpdate)
        geo = QGuiApplication.primaryScreen().availableGeometry()
        ex = max(0, min(EXTRA, (geo.width() - WIN_W) // 2))
        ey = max(0, min(EXTRA, (geo.height() - WIN_H) // 2))
        self.menu_scale = max(0.5, min(MENU_SCALE,
                                       geo.height() * 0.92 / (WIN_H - 2 * MARGIN),
                                       geo.width() * 0.92 / (WIN_W - 2 * MARGIN)))
        self.win_w = WIN_W + 2 * ex
        self.win_h = WIN_H + 2 * ey
        self.setFixedSize(self.win_w, self.win_h)

        self.pw, self.ph = WIN_W - 2 * MARGIN, WIN_H - 2 * MARGIN
        self.mx = (self.win_w - self.pw) // 2
        self.my = (self.win_h - self.ph) // 2
        cx, cy = (self.pw - CARD_W) // 2, (self.ph - CARD_H) // 2

        self.scene_ = QGraphicsScene(0, 0, self.win_w, self.win_h)
        self.setScene(self.scene_)

        # one parent item: the whole surface tilts together
        self.root = QGraphicsRectItem(0, 0, self.pw, self.ph)
        self.root.setPen(QPen(Qt.PenStyle.NoPen))
        self.root.setBrush(QBrush(Qt.BrushStyle.NoBrush))
        self.root.setPos(self.mx, self.my)
        self.scene_.addItem(self.root)

        self.bg_item = BgItem(self.pw, self.ph, QRectF(cx, cy, CARD_W, CARD_H), self.root)
        self.bg_item.set_bg(build_background(self.pw, self.ph))

        banner = build_banner()
        self.card = Card(apps, banner, resolve_accent(banner))
        self.card.launched.connect(self.start_pop_out)
        self.card.closed.connect(self.start_exit)
        self.card.bg_changed.connect(self.rebuild_bg)
        self.proxy = self.scene_.addWidget(self.card)
        self.proxy.setParentItem(self.root)
        self.proxy.setPos(cx, cy)
        if ITEM_CACHE:
            # default cache size = the card's own size (an explicit bigger size made the
            # card render oversized and out of place)
            self.proxy.setCacheMode(QGraphicsItem.CacheMode.ItemCoordinateCache)

        self.nx_s = self.ny_s = 0.0     # smoothed cursor position (-1..1)
        self.intro = 0.0
        self.pop = 0.0
        self.leaving = False
        self._last = None

        self.intro_anim = QVariantAnimation(self)
        self.intro_anim.setDuration(INTRO_MS)
        c = QEasingCurve(QEasingCurve.Type.OutBack)
        c.setOvershoot(1.25)
        self.intro_anim.setEasingCurve(c)
        self.intro_anim.setStartValue(0.0)
        self.intro_anim.setEndValue(1.0)
        self.intro_anim.valueChanged.connect(self._set_intro)

        self.seq_anim = QVariantAnimation(self)
        self.seq_anim.setDuration(INTRO_SEQ_MS)
        self.seq_anim.setEasingCurve(QEasingCurve.Type.Linear)
        self.seq_anim.setStartValue(0.0)
        self.seq_anim.setEndValue(1.0)
        self.seq_anim.valueChanged.connect(lambda v: self.card.set_seq(float(v)))

        self.exit_anim = QVariantAnimation(self)
        self.exit_anim.setDuration(380)
        c2 = QEasingCurve(QEasingCurve.Type.InBack)
        c2.setOvershoot(1.4)
        self.exit_anim.setEasingCurve(c2)
        self.exit_anim.valueChanged.connect(self._set_intro)
        self.exit_anim.finished.connect(QApplication.quit)

        self.pop_anim = QVariantAnimation(self)
        self.pop_anim.setDuration(POP_OUT_MS)
        self.pop_anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        self.pop_anim.setStartValue(0.0)
        self.pop_anim.setEndValue(1.0)
        self.pop_anim.valueChanged.connect(self._set_pop)
        self.pop_anim.finished.connect(QApplication.quit)

        self.timer = QTimer(self)
        self.timer.setInterval(16)
        self.timer.timeout.connect(self.tick)

        self._bg_key = CFG["background_image"]
        self.bg_anim = QVariantAnimation(self)
        self.bg_anim.setDuration(1100)
        self.bg_anim.setEasingCurve(QEasingCurve.Type.InOutCubic)
        self.bg_anim.setStartValue(0.0)
        self.bg_anim.setEndValue(1.0)
        self.bg_anim.valueChanged.connect(self._set_bgt)
        self.bg_anim.finished.connect(self._bg_done)

    def _set_bgt(self, v):
        self.bg_item.t = float(v)
        self.bg_item.update()

    def _bg_done(self):
        self.bg_item.old_bg = None
        self.bg_item.t = 1.0
        self.bg_item.update()

    def rebuild_bg(self):
        key = CFG["background_image"]
        animate = key != self._bg_key               # animate only when the picture changes (not blur / dim)
        self._bg_key = key
        self.bg_item.set_bg(build_background(self.pw, self.ph), animate)
        if animate:
            self.bg_anim.stop()
            self.bg_anim.start()

    def shutdown(self):
        self.card.shutdown()

    def start(self):
        geo = QGuiApplication.primaryScreen().availableGeometry()
        self.move(geo.center().x() - self.win_w // 2, geo.center().y() - self.win_h // 2)
        self.card.set_seq(0.0)
        self._apply()
        # Real icons for the first rows are fetched NOW, before the animation starts.  Before, they were
        # fetched from the OS shell during the first painted frames, which froze the pop-in.
        self.card.list.preload()
        self.show()
        self.raise_()
        self.activateWindow()
        self.proxy.setFocus()
        self.card.search.setFocus()
        self.intro_anim.start()
        self.seq_anim.start()
        self.timer.start()
        QTimer.singleShot(1500, self._start_app_scan)
        QTimer.singleShot(3500, self._warm_index)

    def _start_app_scan(self):
        if not self.leaving:
            self.card.start_app_scan()

    def _warm_index(self):
        if not self.leaving and self.card.index_state == "idle":
            self.card.start_indexing()

    def start_exit(self):
        if self.leaving:
            return
        self.leaving = True
        self.intro_anim.stop()
        self.seq_anim.stop()
        self.exit_anim.setStartValue(float(self.intro))
        self.exit_anim.setEndValue(0.0)
        self.exit_anim.start()

    def start_pop_out(self):
        if self.leaving:
            return
        self.leaving = True
        self.intro_anim.stop()
        self.seq_anim.stop()
        self.intro = 1.0
        self.pop_anim.start()

    def _set_intro(self, v):
        self.intro = float(v)
        self._apply()

    def _set_pop(self, v):
        self.pop = float(v)
        self._apply()

    def tick(self):
        if self.leaving:
            return
        cur = QCursor.pos()
        o = self.mapToGlobal(QPoint(self.width() // 2, self.height() // 2))
        nx = clamp((cur.x() - o.x()) / (WIN_W / 2), -1, 1)
        ny = clamp((cur.y() - o.y()) / (WIN_H / 2), -1, 1)
        self.nx_s += (nx - self.nx_s) * TILT_SMOOTHING
        self.ny_s += (ny - self.ny_s) * TILT_SMOOTHING
        key = (round(self.nx_s, 3), round(self.ny_s, 3), CFG["max_tilt"])
        if key != self._last:
            self._last = key
            self._apply()

    def _apply(self):
        pw, ph = self.pw, self.ph
        sign = 1 if INVERT_TILT else -1
        tilt = float(CFG["max_tilt"])
        rx = sign * self.ny_s * tilt
        ry = sign * self.nx_s * tilt
        fl = 1.0 - self.intro                      # 1 -> 0 (goes slightly negative on the bounce)
        s = (0.55 + 0.45 * self.intro) * (1 + POP_OUT_SCALE * self.pop) * self.menu_scale
        t = QTransform()
        t.translate(pw / 2, ph / 2 + fl * 70)
        t.rotate(rx - fl * INTRO_FLIP, Qt.Axis.XAxis)        # flips up toward you
        t.rotate(ry, Qt.Axis.YAxis)
        t.rotate(fl * INTRO_ROLL)                            # roll straightens out
        t.scale(s, s)
        t.translate(-pw / 2, -ph / 2)
        self.root.setTransform(t)
        self.root.setOpacity(clamp(self.intro * 2.2) * (1 - self.pop))
        self.bg_item.sx = sign * self.nx_s * BG_PAD * 0.45     # parallax
        self.bg_item.sy = -sign * self.ny_s * BG_PAD * 0.45
        self.bg_item.update()
        if not PARTIAL_REPAINT:
            self.viewport().update()

    def keyPressEvent(self, e):
        if e.key() == Qt.Key.Key_Escape:
            if not self.card.on_escape():
                self.start_exit()
            return
        super().keyPressEvent(e)

    def mousePressEvent(self, e):
        # drag the window by grabbing the background around the card
        if e.button() == Qt.MouseButton.LeftButton:
            it = self.itemAt(e.pos())
            if it is None or it is self.bg_item or it is self.root:
                h = self.windowHandle()
                if h:
                    h.startSystemMove()
                    return
        super().mousePressEvent(e)


def main():
    load_config()
    ap = argparse.ArgumentParser(description="Ohio")
    ap.add_argument("--bg", help="background image path")
    ap.add_argument("--banner", help="banner (header) image path")
    ap.add_argument("--blur", type=int, help="background blur radius (0 = sharp)")
    ap.add_argument("--accent", help='selected colour, e.g. "#a8f5ea" or "auto"')
    args = ap.parse_args()
    if args.bg:
        CFG["background_image"] = args.bg
    if args.banner:
        CFG["banner_image"] = args.banner
    if args.blur is not None:
        CFG["background_blur"] = args.blur
    if args.accent:
        CFG["accent"] = args.accent

    # Background threads (file index, app scan) share Python's one interpreter lock with the UI.
    # A shorter switch interval lets the UI thread grab it back almost instantly -> no stutter.
    sys.setswitchinterval(0.001)

    app = QApplication(sys.argv[:1])
    app.setApplicationName("Ohio")
    font = QFont()
    font.setFamilies(FONT_FAMILIES)
    font.setPointSize(10)
    app.setFont(font)

    view = LauncherView(discover_apps())
    app.aboutToQuit.connect(view.shutdown)
    view.start()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
