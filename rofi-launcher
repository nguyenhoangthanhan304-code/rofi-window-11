SKIP_DIRS = {
    "appdata", "windows", "system32", "syswow64", "winsxs", "program files",
    "program files (x86)", "programdata", "$recycle.bin", "system volume information",
    "recovery", "config.msi", "msocache", "node_modules", "__pycache__", "site-packages",
    "venv", "env", "dist-packages", "proc", "sys", "dev", "run", "snap",
}
