# Search box
# ----------------------------------------------------------------------------
class SearchEdit(QLineEdit):
    activated = pyqtSignal()
    reveal = pyqtSignal()
    nav = pyqtSignal(int)
    escaped = pyqtSignal()
    tab = pyqtSignal()
    settings = pyqtSignal()

    def focusNextPrevChild(self, nxt):
        return False

    def keyPressEvent(self, e):
        k = e.key()
        mods = e.modifiers()
        if k in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            if mods & Qt.KeyboardModifier.ShiftModifier:
                self.reveal.emit()
            else:
                self.activated.emit()
        elif k == Qt.Key.Key_Down:
            self.nav.emit(1)
        elif k == Qt.Key.Key_Up:
            self.nav.emit(-1)
        elif k == Qt.Key.Key_PageDown:
            self.nav.emit(7)
        elif k == Qt.Key.Key_PageUp:
            self.nav.emit(-7)
        elif k == Qt.Key.Key_Escape:
            self.escaped.emit()
        elif k == Qt.Key.Key_Tab:
            self.tab.emit()
        elif k == Qt.Key.Key_Comma and (mods & Qt.KeyboardModifier.ControlModifier):
            self.settings.emit()
        else:
            super().keyPressEvent(e)
            return
        e.accept()


# ----------------------------------------------------------------------------
# Virtualised list (paints only the visible rows -> fast with 100k+ items)
# + "push" transition: old list slides/fades away, new rows fly in (staggered)
# ----------------------------------------------------------------------------
class ItemList(QWidget):
    activated = pyqtSignal(object)
    ROW_H = 50
    PAD = 8

    def __init__(self, theme, accent):
        super().__init__()
        self.theme = theme
        self.accent = accent
        self.items = []
        self.sel = -1
        self.sel_y = float(self.PAD)
        self.hover = -1
        self.offset = 0.0
        self.target = 0.0
        self.seq = 1.0
        self.message = ""
        self._mouse = None
        self._drag = False
        self.f_name = mono_font(15)
        self.f_dim = mono_font(12)
        self.f_msg = mono_font(14)
        self.fm_name = QFontMetrics(self.f_name)
        self.fm_dim = QFontMetrics(self.f_dim)
        self._el_name = {}          # (text, width) -> elided text   (elidedText is slow to run 60x a second)
        self._el_dim = {}
        self._iq = {}               # icons waiting to be loaded (key -> item)
        self.setMouseTracking(True)
        self.timer = QTimer(self)
        self.timer.setInterval(16)
        self.timer.timeout.connect(self._tick)
        self.icon_timer = QTimer(self)
        self.icon_timer.setInterval(6)
        self.icon_timer.timeout.connect(self._load_icons)

        # transition state
        self.tr = 1.0               # 0 -> 1 progress (1 = finished)
        self.tr_dir = 0             # +1 = going deeper, -1 = going back, 0 = fade only
        self.snap = None            # picture of the old list
        self._pending = None        # direction waiting for the next set_items()
        self.tr_anim = QVariantAnimation(self)
        self.tr_anim.setDuration(TRANSITION_MS)
        self.tr_anim.setEasingCurve(QEasingCurve.Type.Linear)
        self.tr_anim.setStartValue(0.0)
        self.tr_anim.setEndValue(1.0)
        self.tr_anim.valueChanged.connect(self._set_tr)
        self.tr_anim.finished.connect(self._tr_done)

    # --- icons: never loaded while painting ----------------------------------
    def preload(self, n=9):
        """Load the first rows' real icons NOW (before the window opens) and queue a few more."""
        for it in self.items[:n]:
            item_icon(it)
        for it in self.items[n:n + 60]:
            self._queue_icon(it)

    def _queue_icon(self, item):
        k = item.icon_key
        if k in _icon_cache or k in self._iq:
            return
        if len(self._iq) > 300:                       # scrolled far past them: forget the old requests
            for old in list(self._iq)[:-80]:
                del self._iq[old]
        self._iq[k] = item
        if not self.icon_timer.isActive():
            self.icon_timer.start()

    def _load_icons(self):
        t0 = time.perf_counter()
        loaded = False
        while self._iq:
            k, item = self._iq.popitem()              # newest request first = the rows you are looking at
            if k not in _icon_cache:
                item_icon(item)
                loaded = True
            if time.perf_counter() - t0 > 0.004:      # never hog the UI thread for more than ~4 ms
                break
        if loaded:
            self.update()
        if not self._iq:
            self.icon_timer.stop()

    def _elide(self, cache, fm, text, width):
        k = (text, width)
        s = cache.get(k)
        if s is None:
            if len(cache) > 4000:
                cache.clear()
            s = fm.elidedText(text, Qt.TextElideMode.ElideRight if cache is self._el_name
                              else Qt.TextElideMode.ElideLeft, width)
            cache[k] = s
        return s

    # --- transition --------------------------------------------------------
    def begin_transition(self, direction):
        """Call right BEFORE the content changes; the next set_items() plays the animation."""
        snap = None
        try:
            if self.isVisible() and self.width() > 0 and self.height() > 0:
                dpr = self.devicePixelRatioF()
                snap = QPixmap(int(self.width() * dpr), int(self.height() * dpr))
                snap.setDevicePixelRatio(dpr)
                snap.fill(Qt.GlobalColor.transparent)
                # DrawChildren only -> no window background, so the old list keeps the card's colour
                self.render(snap, QPoint(), QRegion(), QWidget.RenderFlag.DrawChildren)
        except Exception:
            snap = None
        self.snap = snap
        self._pending = direction

    def _set_tr(self, v):
        self.tr = float(v)
        self.update()

    def _tr_done(self):
        self.tr = 1.0
        self.snap = None
        self.update()

    # --- model -------------------------------------------------------------
    def content_h(self):
        return len(self.items) * self.ROW_H + 2 * self.PAD

    def max_offset(self):
        return max(0.0, self.content_h() - self.height())

    def _row_top(self, i):
        return self.PAD + i * self.ROW_H

    def set_items(self, items):
        self.items = items
        self.sel = 0 if items else -1
        self.sel_y = float(self._row_top(0))
        self.offset = self.target = 0.0
        self._iq.clear()
        if self._pending is not None:
            self.tr_dir = self._pending
            self._pending = None
            self.tr = 0.0
            self.tr_anim.stop()
            self.tr_anim.start()
        self._update_hover()
        self.update()

    def replace_items(self, items):
        """Swap in a new list WITHOUT jumping: keeps the selected item and the scroll position."""
        cur = self.current()
        keep = -1
        if cur is not None:
            try:
                keep = items.index(cur)
            except ValueError:
                keep = -1
        self.items = items
        self.sel = keep if keep >= 0 else (0 if items else -1)
        self.sel_y = float(self._row_top(max(self.sel, 0)))
        mo = self.max_offset()
        self.offset = clamp(self.offset, 0, mo)
        self.target = clamp(self.target, 0, mo)
        self.update()

    def current(self):
        return self.items[self.sel] if 0 <= self.sel < len(self.items) else None

    def select(self, i, ensure=True):
        if not self.items:
            return
        self.sel = int(clamp(i, 0, len(self.items) - 1))
        if ensure:
            self.ensure_visible(self.sel)
        self._start()

    def step(self, step):
        self.select((self.sel if self.sel >= 0 else -1) + step)

    def ensure_visible(self, i):
        top, bot = self._row_top(i), self._row_top(i) + self.ROW_H
        vh = self.height()
        t = self.target
        if top - 6 < t:
            t = top - 6
        elif bot + 6 > t + vh:
            t = bot + 6 - vh
        self.target = clamp(t, 0, self.max_offset())

    # --- animation ---------------------------------------------------------
    def _start(self):
        if not self.timer.isActive():
            self.timer.start()

    def _refresh_edges(self):
        """Re-render the thin strips just above / below the list (banner + card border) so nothing
        from a previous scroll position can ever linger there."""
        par = self.parentWidget()
        if par is None:
            return
        g = self.geometry()
        par.update(QRect(g.left(), g.top() - 20, g.width(), 20))
        par.update(QRect(g.left(), g.bottom() + 1, g.width(), 16))

    def _tick(self):
        moving = False
        d = self.target - self.offset
        if abs(d) > 0.4:
            self.offset += d * SCROLL_EASE
            moving = True
        else:
            self.offset = self.target
        ty = float(self._row_top(self.sel)) if self.sel >= 0 else float(self.PAD)
        dy = ty - self.sel_y
        if abs(dy) > 0.4:
            self.sel_y += dy * 0.35
            moving = True
        else:
            self.sel_y = ty
        if self._mouse is not None:
            self._update_hover()
        self.update()
        self._refresh_edges()
        if not moving:
            self.timer.stop()

    def resizeEvent(self, e):
        mo = self.max_offset()
        self.target = clamp(self.target, 0, mo)
        self.offset = clamp(self.offset, 0, mo)

    # --- input -------------------------------------------------------------
    def _index_at(self, y):
        i = int((y + int(round(self.offset)) - self.PAD) // self.ROW_H)
        return i if 0 <= i < len(self.items) else -1

    def _update_hover(self):
        i = self._index_at(self._mouse.y()) if self._mouse is not None else -1
        if i != self.hover:
            self.hover = i
            self.update()

    def _handle_geom(self):
        H = self.height()
        track_top, track_h = 8.0, H - 16.0
        hh = max(40.0, track_h * H / max(1.0, self.content_h()))
        return track_top, track_h, hh

    def _drag_to(self, y):
        track_top, track_h, hh = self._handle_geom()
        span = max(1.0, track_h - hh)
        ratio = clamp((y - track_top - hh / 2) / span)
        self.offset = self.target = ratio * self.max_offset()
        self.update()

    def wheelEvent(self, e):
        delta = e.angleDelta().y() or e.pixelDelta().y()
        self.target = clamp(self.target - delta * SCROLL_SPEED, 0, self.max_offset())
        self._start()
        e.accept()

    def mouseMoveEvent(self, e):
        self._mouse = e.position().toPoint()
        if self._drag:
            self._drag_to(self._mouse.y())
        else:
            self._update_hover()

    def leaveEvent(self, e):
        self._mouse = None
        if self.hover != -1:
            self.hover = -1
            self.update()

    def mousePressEvent(self, e):
        if e.button() != Qt.MouseButton.LeftButton:
            return
        pos = e.position().toPoint()
        if self.max_offset() > 0 and pos.x() >= self.width() - 18:
            self._drag = True
            self._drag_to(pos.y())
            return
        i = self._index_at(pos.y())
        if i >= 0:
            self.select(i, ensure=False)

    def mouseReleaseEvent(self, e):
        self._drag = False
        self.update()

    def mouseDoubleClickEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            i = self._index_at(e.position().toPoint().y())
            if i >= 0:
                self.select(i, ensure=False)
                self.activated.emit(self.items[i])

    # --- painting ----------------------------------------------------------
    def paintEvent(self, e):
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform
                         | QPainter.RenderHint.TextAntialiasing)
        th = self.theme
        W, H = self.width(), self.height()
        p.setClipRect(0, 0, W, H)                    # nothing can ever be painted outside the list
        n = len(self.items)
        tr, d = self.tr, self.tr_dir
        sl = TRANSITION_SLIDE

        # old list sliding + fading away
        if self.snap is not None and tr < 1.0:
            so = clamp(tr / 0.5)
            if so < 1.0:
                p.save()
                p.setOpacity(1.0 - so)
                eo = ease_out_cubic(so)
                p.drawPixmap(QPointF(-d * eo * sl, (-eo * 8) if d == 0 else 0.0), self.snap)
                p.restore()

        if n == 0:
            if self.message:
                p.setOpacity(ease_out_cubic(clamp((tr - 0.2) / 0.6)))
                p.setFont(self.f_msg)
                p.setPen(th.mix(*DIM))
                p.drawText(QRectF(0, 0, W, H * 0.7), Qt.AlignmentFlag.AlignCenter, self.message)
            return
        rh = self.ROW_H
        x0, x1 = 20.0, W - 24.0
        off = int(round(self.offset))                # whole pixels only -> crisp text, icon + text never drift apart
        tpill = 1.0 if tr >= 1.0 else ease_out_cubic(clamp((tr - 0.12) / 0.5))

        # sliding selection pill
        if self.sel >= 0:
            a = ease_out_cubic(clamp((self.seq - 0.22) / 0.35)) * tpill
            y = int(round(self.sel_y)) - off
            if a > 0 and -rh < y < H:
                pill = QRectF(x0 + (1 - tpill) * d * sl, y + 4 + ((1 - tpill) * 14 if d == 0 else 0),
                              x1 - x0, rh - 8)
                path = QPainterPath()
                path.addRoundedRect(pill, pill.height() / 2, pill.height() / 2)
                p.fillPath(path, with_alpha(self.accent, 255 * a))

        first = max(0, int((off - self.PAD) // rh))
        last = min(n - 1, int((off + H - self.PAD) // rh))
        col_text, col_dim = th.mix(*TEXT), th.mix(*DIM)
        for i in range(first, last + 1):
            # (the stagger is capped at row 10 so it always FINISHES when the intro ends -
            #  before, rows below #13 stayed 1px shifted + slightly see-through forever)
            ap = ease_out_cubic(clamp((self.seq - (0.22 + min(i, 10) * 0.035)) / 0.4))
            if ap <= 0:
                continue
            if tr >= 1.0:
                tp = 1.0
            else:
                tp = ease_out_cubic(clamp((tr - 0.12 - min(i - first, 12) * 0.03) / 0.5))
                if tp <= 0:
                    continue
            item = self.items[i]
            top = self.PAD + i * rh
            y = top - off
            r = QRectF(x0, y + 4, x1 - x0, rh - 8)
            ov = clamp(1 - abs(top - self.sel_y) / rh) * tpill   # how much the pill covers this row
            settled = ap >= 0.999 and tp >= 0.999
            if not settled:
                p.save()
                p.setOpacity(ap * tp)
                p.translate((1 - ap) * 46 + (1 - tp) * d * sl, ((1 - tp) * 14) if d == 0 else 0)
            if i == self.hover and ov < 0.5:
                hp = QPainterPath()
                hp.addRoundedRect(r, r.height() / 2, r.height() / 2)
                p.fillPath(hp, th.mix(*HOVER))

            icon_rect = QRectF(r.left() + 20, r.center().y() - 14, 28, 28)
            pm = _icon_cache.get(item.icon_key, False)
            if pm is False:
                self._queue_icon(item)               # real icon arrives a few ms later, scrolling never stalls
            elif pm is not None:
                p.drawPixmap(icon_rect, pm, QRectF(pm.rect()))
            else:
                draw_fallback_icon(p, item.name if item.kind == "app" else (item.ext[1:] or item.name), icon_rect)

            tx = icon_rect.right() + 14
            avail = r.right() - tx - 22
            par = item.parent
            nw = avail * 0.62 if par else avail
            p.setFont(self.f_name)
            p.setPen(lerp_color(col_text, SEL_TEXT, ov))
            p.drawText(QRectF(tx, r.top(), nw, r.height()),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                       self._elide(self._el_name, self.fm_name, item.name, int(nw)))
            if par:
                dw = avail - nw - 10
                if dw > 30:
                    p.setFont(self.f_dim)
                    dc = lerp_color(col_dim, with_alpha(SEL_TEXT, 150), ov)
                    p.setPen(dc)
                    p.drawText(QRectF(tx + nw + 10, r.top(), dw, r.height()),
                               Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                               self._elide(self._el_dim, self.fm_dim, par, int(dw)))
            if not settled:
                p.restore()

        # scrollbar
        mo = self.max_offset()
        if mo > 0:
            track_top, track_h, hh = self._handle_geom()
            hy = track_top + (off / mo) * (track_h - hh)
            col = th.mix(*SCROLLC)
            if self._drag:
                col.setAlpha(min(255, col.alpha() + 80))
            p.setOpacity(tpill)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(col)
            p.drawRoundedRect(QRectF(W - 11, hy, 6, hh), 3, 3)


# ----------------------------------------------------------------------------
# SlideBar: base for the path bar / sort bar.  Opens and closes with a smooth
# height + fade animation instead of popping in.
# ----------------------------------------------------------------------------
class SlideBar(QWidget):
    H = 40

    def __init__(self):
        super().__init__()
        self.vis = 0.0
        self.want = False
        self.setFixedHeight(0)
        self._slide_anim = QVariantAnimation(self)
        self._slide_anim.setDuration(BAR_SLIDE_MS)
        self._slide_anim.valueChanged.connect(self._set_vis)
        self._slide_anim.finished.connect(self._slide_done)
        QWidget.hide(self)

    def _set_vis(self, v):
        self.vis = clamp(float(v))
        self.setFixedHeight(max(0, int(round(self.H * self.vis))))
        self.update()

    def _slide_done(self):
        if not self.want:
            QWidget.hide(self)

    def slide(self, show):
        was_hidden = (not self.want) or (not self.isVisible())
        self.want = bool(show)
        self._slide_anim.stop()
        self._slide_anim.setStartValue(self.vis)
        self._slide_anim.setEndValue(1.0 if show else 0.0)
        self._slide_anim.setEasingCurve(QEasingCurve.Type.OutCubic if show else QEasingCurve.Type.InCubic)
        if show:
            self.show()
            if was_hidden:
                self.on_show()
        self._slide_anim.start()

    def on_show(self):
        pass

    def _enter(self, p):
        p.setOpacity(clamp(self.vis * 1.6))


# ----------------------------------------------------------------------------
# Sort bar (files mode) - gliding pill, rotating arrow, pop-in chips, bounce
# ----------------------------------------------------------------------------
class SortBar(SlideBar):
    changed = pyqtSignal(str, bool)
    H = 40
    CHIPS = (("name", "Name"), ("date", "Modified"), ("size", "Size"), ("type", "Type"))
    ARROW_SLOT = 14

    def __init__(self, theme, accent):
        super().__init__()
        self.theme = theme
        self.accent = accent
        self.key = CFG["file_sort"]
        self.asc = bool(CFG["file_sort_asc"])
        self.status = ""
        self.old_status = ""
        self.st_t = 1.0
        self.cur = -1                                   # hovered chip
        n = len(self.CHIPS)
        self.act = [1.0 if k == self.key else 0.0 for k, _ in self.CHIPS]
        self.hov = [0.0] * n
        self.bounce = [0.0] * n
        self.arrow = 0.0 if self.asc else 180.0         # degrees (0 = up, 180 = down)
        self.intro = 1.0
        self.rects = []
        self.f = mono_font(12)
        self.fm = QFontMetrics(self.f)
        self.setMouseTracking(True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.timer = QTimer(self)
        self.timer.setInterval(16)
        self.timer.timeout.connect(self._tick)

    def on_show(self):
        self.intro = 0.0
        self._start()

    def _start(self):
        if not self.timer.isActive():
            self.timer.start()

    def set_status(self, s):
        if s == self.status:
            return
        self.old_status = self.status
        self.status = s
        self.st_t = 0.0
        self._start()

    def _tick(self):
        moving = False
        for i, (k, _) in enumerate(self.CHIPS):
            ta = 1.0 if k == self.key else 0.0
            d = ta - self.act[i]
            if abs(d) > 0.002:
                self.act[i] += d * 0.2
                moving = True
            else:
                self.act[i] = ta
            th_ = 1.0 if (i == self.cur and ta == 0.0) else 0.0
            d = th_ - self.hov[i]
            if abs(d) > 0.01:
                self.hov[i] += d * 0.28
                moving = True
            else:
                self.hov[i] = th_
            if self.bounce[i] > 0.01:
                self.bounce[i] *= 0.82
                moving = True
            else:
                self.bounce[i] = 0.0
        ta = 0.0 if self.asc else 180.0
        d = ta - self.arrow
        if abs(d) > 0.4:
            self.arrow += d * 0.22
            moving = True
        else:
            self.arrow = ta
        if self.intro < 1.0:
            self.intro = min(1.0, self.intro + 0.032)
            moving = True
        if self.st_t < 1.0:
            self.st_t = min(1.0, self.st_t + 0.07)
            moving = True
        self.update()
        if not moving:
            self.timer.stop()

    def _layout(self):
        fm = self.fm
        x = 26 + fm.horizontalAdvance("SORT") + 14
        self.rects = []
        for i, (key, label) in enumerate(self.CHIPS):
            adv = fm.horizontalAdvance(label)
            w = adv + 26 + self.ARROW_SLOT * self.act[i]
            self.rects.append((key, label, adv, QRectF(x, (self.H - 26) / 2, w, 26)))
            x += w + 6

    def _chip_at(self, pos):
        self._layout()
        for i, (_, _, _, r) in enumerate(self.rects):
            if r.contains(QPointF(pos)):
                return i
        return -1

    def mouseMoveEvent(self, e):
        i = self._chip_at(e.position())
        if i != self.cur:
            self.cur = i
            self._start()

    def leaveEvent(self, e):
        self.cur = -1
        self._start()

    def mousePressEvent(self, e):
        i = self._chip_at(e.position())
        if i < 0 or e.button() != Qt.MouseButton.LeftButton:
            return
        key = self.rects[i][0]
        self.bounce[i] = 1.0
        if key == self.key:
            self.asc = not self.asc
        else:
            self.key = key
            self.asc = key in ("name", "type")
        self._start()
        self.changed.emit(self.key, self.asc)
        e.accept()

    def _draw_arrow(self, p, c, deg, scale, color):
        p.save()
        p.translate(c)
        p.rotate(deg)
        p.scale(scale, scale)
        p.setPen(QPen(color, 1.9, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawLine(QPointF(0, 4.2), QPointF(0, -4.2))
        p.drawPolyline(QPolygonF([QPointF(-3.2, -1.2), QPointF(0, -4.4), QPointF(3.2, -1.2)]))
        p.restore()

    def paintEvent(self, e):
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.TextAntialiasing)
        self._enter(p)
        base_op = p.opacity()
        th = self.theme
        self._layout()
        p.setFont(self.f)
        dim = th.mix(*DIM)
        txt_col = th.mix(*TEXT)

        p.setPen(dim)
        p.drawText(QRectF(26, 0, 80, self.H), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, "SORT")

        # per-chip intro (pop in one by one)
        ips = [ease_out_back(clamp((self.intro - i * 0.1) / 0.6)) for i in range(len(self.CHIPS))]

        # inactive chip backgrounds
        for i, (key, label, adv, r) in enumerate(self.rects):
            ip = ips[i]
            if ip <= 0:
                continue
            c = th.mix(*CHIP)
            c.setAlpha(min(255, int(c.alpha() + 40 * self.hov[i])))
            p.save()
            p.setOpacity(base_op * clamp(ip * 1.6) * (1 - self.act[i]))
            cc = r.center()
            s = max(0.0, ip) * (1 - 0.10 * self.bounce[i]) * (1 + 0.04 * self.hov[i])
            p.translate(cc)
            p.scale(s, s)
            p.translate(-cc)
            path = QPainterPath()
            path.addRoundedRect(r, 13, 13)
            p.fillPath(path, c)
            p.restore()

        # the accent pill glides between chips (weighted by how "active" each chip is)
        s_act = sum(self.act) or 1.0
        px = sum(self.act[i] * self.rects[i][3].x() for i in range(len(self.rects))) / s_act
        pw = sum(self.act[i] * self.rects[i][3].width() for i in range(len(self.rects))) / s_act
        ip_pill = sum(self.act[i] * ips[i] for i in range(len(self.rects))) / s_act
        bnc = sum(self.act[i] * self.bounce[i] for i in range(len(self.rects))) / s_act
        if ip_pill > 0:
            pr = QRectF(px, (self.H - 26) / 2, pw, 26)
            p.save()
            p.setOpacity(base_op * clamp(ip_pill * 1.6))
            cc = pr.center()
            s = max(0.0, ip_pill) * (1 - 0.10 * bnc)
            p.translate(cc)
            p.scale(s, s)
            p.translate(-cc)
            path = QPainterPath()
            path.addRoundedRect(pr, 13, 13)
            p.fillPath(path, self.accent)
            p.restore()

        # labels + arrow
        for i, (key, label, adv, r) in enumerate(self.rects):
            ip = ips[i]
            if ip <= 0:
                continue
            a = self.act[i]
            p.save()
            p.setOpacity(base_op * clamp(ip * 1.6))
            cc = r.center()
            s = max(0.0, ip) * (1 - 0.10 * self.bounce[i])
            p.translate(cc)
            p.scale(s, s)
            p.translate(-cc)
            col = lerp_color(txt_col, SEL_TEXT, a)
            p.setPen(col)
            p.drawText(QRectF(r.left() + 13, r.top(), adv + 4, r.height()),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, label)
            if a > 0.03:
                ac = QPointF(r.left() + 13 + adv + 10, r.center().y())
                self._draw_arrow(p, ac, self.arrow, a, with_alpha(SEL_TEXT, 255 * a))
            p.restore()

        # status text: old slides up + fades, new slides in from below
        p.setFont(self.f)
        tr = QRectF(self.width() - 230, 0, 204, self.H)
        al = Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter
        t = ease_out_cubic(self.st_t)
        if self.st_t < 1.0 and self.old_status:
            p.save()
            p.setOpacity(base_op * (1 - clamp(self.st_t * 2.2)))
            p.setPen(dim)
            p.drawText(tr.translated(0, -8 * t), al, self.old_status)
            p.restore()
        p.save()
        p.setOpacity(base_op * clamp(self.st_t * 2.0))
        p.setPen(dim)
        p.drawText(tr.translated(0, 8 * (1 - t)), al, self.status)
        p.restore()


# ----------------------------------------------------------------------------
# Path bar (shown while you are inside a folder): ">" exit button + current path
# The path is "typed" out with a caret; the button ripples on every folder change.
# ----------------------------------------------------------------------------
class PathBar(SlideBar):
    exit = pyqtSignal()
    H = 44

    def __init__(self, theme, accent):
        super().__init__()
        self.theme = theme
        self.accent = accent
        self.path = ""
        self.old = ""
        self.dir = 1
        self.t = 1.0
        self.hov = False
        self._down = False
        self.f = mono_font(13)                  # built once (was rebuilt on every single repaint)
        self.fm = QFontMetrics(self.f)
        self.setMouseTracking(True)
        self.anim = QVariantAnimation(self)
        self.anim.setDuration(PATH_TYPE_MS)
        self.anim.setEasingCurve(QEasingCurve.Type.Linear)
        self.anim.setStartValue(0.0)
        self.anim.setEndValue(1.0)
        self.anim.valueChanged.connect(self._set_t)
        self.anim.finished.connect(self._done)

    def _set_t(self, v):
        self.t = float(v)
        self.update()

    def _done(self):
        self.t = 1.0
        self.old = ""
        self.update()

    def _play(self):
        self.t = 0.0
        self.anim.stop()
        self.anim.start()

    def on_show(self):
        self.old = ""
        self.dir = 1
        self._play()

    def _btn(self):
        return QRectF(26, (self.H - 30) / 2, 30, 30)

    def set_path(self, p, direction=1):
        disp = ("~" + p[len(HOME):]) if p.startswith(HOME) else p
        if disp == self.path:
            return
        self.old = self.path
        self.path = disp
        self.dir = direction
        self._play()

    def mouseMoveEvent(self, e):
        h = self._btn().contains(e.position())
        if h != self.hov:
            self.hov = h
            self.setCursor(Qt.CursorShape.PointingHandCursor if h else Qt.CursorShape.ArrowCursor)
            self.update()

    def leaveEvent(self, e):
        self.hov = False
        self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton and self._btn().contains(e.position()):
            self._down = True
            e.accept()

    def mouseReleaseEvent(self, e):
        was, self._down = self._down, False
        if was and self._btn().contains(e.position()):
            self.exit.emit()
        e.accept()

    def paintEvent(self, e):
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.TextAntialiasing)
        self._enter(p)
        base_op = p.opacity()
        th = self.theme
        t = self.t
        te = ease_out_cubic(t)
        d = self.dir

        # ---- exit button (ripple ring + bump + arrow nudge) ----
        r = self._btn()
        c = r.center()
        if t < 1.0:
            rr = 15 + 6 * te
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(with_alpha(self.accent, 190 * (1 - te)), 2.0))
            p.drawEllipse(c, rr, rr)
        p.save()
        p.translate(c)
        s = (1.08 if self.hov else 1.0) * (1 + 0.12 * math.sin(math.pi * t))
        p.scale(s, s)
        p.translate(-c)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(self.accent)
        p.drawEllipse(r)
        nud = math.sin(math.pi * t) * 3.2 * d
        p.setPen(QPen(SEL_TEXT, 2.4, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
        p.drawPolyline(QPolygonF([QPointF(c.x() - 2.5 + nud, c.y() - 5.5), QPointF(c.x() + 3 + nud, c.y()),
                                  QPointF(c.x() - 2.5 + nud, c.y() + 5.5)]))
        p.restore()

        # ---- path text ----
        fm = self.fm
        p.setFont(self.f)
        w = self.width() - 70 - 26
        box = QRectF(70, 0, w, self.H)
        al = Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter
        col = th.mix(*TEXT)

        # old text slides away and fades
        if self.old and t < 1.0:
            oa = 1 - clamp(t * 2.4)
            if oa > 0:
                p.save()
                p.setClipRect(box)
                p.setOpacity(base_op * oa)
                p.setPen(col)
                p.drawText(box.translated(-d * te * 36, 0), al,
                           fm.elidedText(self.old, Qt.TextElideMode.ElideLeft, int(w)))
                p.restore()

        # new text is typed in, left -> right, sliding in a little
        txt = fm.elidedText(self.path, Qt.TextElideMode.ElideLeft, int(w))
        tw = fm.horizontalAdvance(txt)
        dx = (1 - te) * d * 24
        p.save()
        p.setOpacity(base_op * clamp(t * 3.0))
        if t < 1.0:
            p.setClipRect(QRectF(70, 0, tw * te + 3, self.H))
        p.setPen(col)
        p.drawText(box.translated(dx, 0), al, txt)
        p.restore()

        # caret at the typing edge
        if t < 1.0:
            ca = clamp((1 - t) * 2.2)
            cx = 70 + dx + tw * te + 2
            p.setOpacity(base_op * ca)
            p.setPen(QPen(self.accent, 2.0, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            p.drawLine(QPointF(cx, self.H / 2 - 9), QPointF(cx, self.H / 2 + 9))


