    SKIP_DIRS |= {"library", "system", "private"}
SKIP_FILES = {"desktop.ini", "thumbs.db", "ntuser.dat", ".ds_store"}


def list_dir(path):
    """Contents of one folder (same 'public files only' rules as the index)."""
    out = []
    try:
        with os.scandir(path) as it:
            for en in it:
                try:
                    name = en.name
                    if name.startswith(".") or en.is_symlink():
                        continue
                    st = en.stat(follow_symlinks=False)
                    attrs = getattr(st, "st_file_attributes", 0)
                    if attrs & 0x6:
                        continue
                    if en.is_dir(follow_symlinks=False):
                        if attrs & 0x400 or name.lower() in SKIP_DIRS:
                            continue
                        out.append(FileItem(en.path, st.st_mtime, 0, True))
                    else:
                        if name.lower() in SKIP_FILES:
                            continue
                        out.append(FileItem(en.path, st.st_mtime, st.st_size, False))
                except OSError:
                    continue
    except OSError:
        pass
    for it in out:
        it.parent = ""
    return out


class FileIndexer(QThread):
    """Runs in the background.  Everything here is deliberately chopped into small pieces with tiny
    sleeps in between: Python threads share ONE interpreter lock (the GIL), so a long unbroken loop
    here would make the animation / scrolling in the UI thread stutter or freeze."""
    loaded = pyqtSignal(object)     # quick result from the on-disk cache
    done = pyqtSignal(object)       # fresh full scan
    progress = pyqtSignal(int)
    CHUNK = 4000

    def __init__(self, roots):
        super().__init__()
        self.roots = roots
        self._stop = False

    def stop(self):
        self._stop = True

    def run(self):
        sig = "|".join(self.roots)
        try:
            with open(INDEX_CACHE, "rb") as fh:
                head = pickle.load(fh)
                if head.get("sig") == sig and head.get("v") == 2:
                    items = []
                    for _ in range(int(head.get("chunks", 0))):
                        if self._stop:
                            return
                        items.extend(FileItem(*t) for t in pickle.load(fh))
                        time.sleep(0.001)                     # let the UI thread breathe
                    if items and not self._stop:
                        self.loaded.emit(items)
        except Exception:
            pass

        tuples = []
        stack = list(self.roots)
        count = 0
        seen = 0
        while stack and not self._stop and count < MAX_FILES:
            d = stack.pop()
            try:
                it = os.scandir(d)
            except OSError:
                continue
            with it:
                for en in it:
                    if self._stop:
                        break
                    seen += 1
                    if seen % 400 == 0:
                        time.sleep(0.001)                     # give the GIL back to the UI thread
                    try:
                        name = en.name
                        low = name.lower()
                        if name.startswith(".") or en.is_symlink():
                            continue
                        st = en.stat(follow_symlinks=False)
                        attrs = getattr(st, "st_file_attributes", 0)
                        if attrs & 0x6:                     # hidden | system
                            continue
                        if en.is_dir(follow_symlinks=False):
                            if attrs & 0x400 or low in SKIP_DIRS:   # reparse point / system folder
                                continue
                            stack.append(en.path)
                            tuples.append((en.path, st.st_mtime, 0, True))
                        else:
                            if low in SKIP_FILES:
                                continue
                            tuples.append((en.path, st.st_mtime, st.st_size, False))
                        count += 1
                        if count % 4000 == 0:
                            self.progress.emit(count)
                    except OSError:
                        continue
        if self._stop:
            return
        items = []
        for n, t in enumerate(tuples):
            items.append(FileItem(*t))
            if n % 3000 == 2999:
                if self._stop:
                    return
                time.sleep(0.001)
        self.done.emit(items)

        tmp = str(INDEX_CACHE) + ".tmp"
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            chunks = [tuples[i:i + self.CHUNK] for i in range(0, len(tuples), self.CHUNK)]
            with open(tmp, "wb") as fh:
                pickle.dump({"sig": sig, "v": 2, "chunks": len(chunks)}, fh, protocol=4)
                for ch in chunks:
                    if self._stop:
                        raise RuntimeError("stopped")
                    pickle.dump(ch, fh, protocol=4)
                    time.sleep(0.001)
            os.replace(tmp, str(INDEX_CACHE))
        except Exception:
            try:
                os.remove(tmp)
            except Exception:
                pass


# ----------------------------------------------------------------------------
# Wallpaper / background / banner
# ----------------------------------------------------------------------------
def get_wallpaper_path():
    try:
        if sys.platform.startswith("win"):
            buf = ctypes.create_unicode_buffer(512)
            ctypes.windll.user32.SystemParametersInfoW(0x0073, len(buf), buf, 0)
            if buf.value and os.path.exists(buf.value):
                return buf.value
            tw = Path(os.environ.get("APPDATA", "")) / "Microsoft/Windows/Themes/TranscodedWallpaper"
            if tw.exists():
                return str(tw)
        elif sys.platform == "darwin":
            out = subprocess.run(
                ["osascript", "-e", 'tell application "System Events" to get picture of current desktop'],
                capture_output=True, text=True, timeout=5).stdout.strip()
            if out and os.path.exists(out):
                return out
        else:
            for key in ("picture-uri-dark", "picture-uri"):
                out = subprocess.run(["gsettings", "get", "org.gnome.desktop.background", key],
                                     capture_output=True, text=True, timeout=3).stdout.strip().strip("'\"")
                if out.startswith("file://"):
                    out = out[7:]
                if out and os.path.exists(out):
                    return out
    except Exception:
        pass
    return None


def background_source_path():
    if valid_image(CFG["background_image"]):
        return resolve_path(CFG["background_image"])
    return get_wallpaper_path()


def fallback_wallpaper(w, h):
    img = QImage(w, h, QImage.Format.Format_ARGB32_Premultiplied)
    p = QPainter(img)
    g = QLinearGradient(0, 0, w, h)
    g.setColorAt(0.0, QColor("#f7a8c4"))
    g.setColorAt(0.5, QColor("#d76d97"))
    g.setColorAt(1.0, QColor("#7b5ea7"))
    p.fillRect(0, 0, w, h, g)
    p.end()
    return QPixmap.fromImage(img)


def build_background(w, h):
    path = background_source_path()
    pm = QPixmap(path) if path else QPixmap()
    if pm.isNull():
        pm = fallback_wallpaper(w, h)
    bw, bh = w + 2 * BG_PAD, h + 2 * BG_PAD
    pm = pm.scaled(bw, bh, Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                   Qt.TransformationMode.SmoothTransformation)
    pm = pm.copy((pm.width() - bw) // 2, (pm.height() - bh) // 2, bw, bh)

    blur = int(CFG["background_blur"])
    if blur > 0:
        scene = QGraphicsScene()
        item = QGraphicsPixmapItem(pm)
        eff = QGraphicsBlurEffect()
        eff.setBlurRadius(blur)
        eff.setBlurHints(QGraphicsBlurEffect.BlurHint.QualityHint)
        item.setGraphicsEffect(eff)
        scene.addItem(item)
        img = QImage(bw, bh, QImage.Format.Format_ARGB32_Premultiplied)
        img.fill(Qt.GlobalColor.transparent)
        p = QPainter(img)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        scene.render(p, QRectF(0, 0, bw, bh), QRectF(0, 0, bw, bh))
        p.end()
    else:
        img = pm.toImage().convertToFormat(QImage.Format.Format_ARGB32_Premultiplied)

    p = QPainter(img)
    p.fillRect(0, 0, bw, bh, QColor(8, 10, 22, int(clamp(CFG["background_dim"], 0, 255))))
    p.end()
    return QPixmap.fromImage(img)


def build_banner():
    if valid_image(CFG["banner_image"]):
        path = resolve_path(CFG["banner_image"])
    else:
        path = get_wallpaper_path()            # never follows the background setting
    pm = QPixmap(path) if path else QPixmap()
    if pm.isNull():
        pm = fallback_wallpaper(CARD_W, HEADER_H)
    pm = pm.scaled(CARD_W, HEADER_H, Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                   Qt.TransformationMode.SmoothTransformation)
    x = (pm.width() - CARD_W) // 2
    y = int((pm.height() - HEADER_H) * clamp(float(CFG["banner_focus_y"])))
    return pm.copy(x, y, CARD_W, HEADER_H)


def resolve_accent(banner):
    if str(CFG["accent"]).lower() == "auto":
        c = banner.toImage().scaled(1, 1, Qt.AspectRatioMode.IgnoreAspectRatio,
                                    Qt.TransformationMode.SmoothTransformation).pixelColor(0, 0)
        h = c.hslHueF()
        if h < 0:
            h = 0.45
        return QColor.fromHslF(h, clamp(c.hslSaturationF(), 0.45, 0.9), 0.80)
    c = QColor(str(CFG["accent"]))
    return c if c.isValid() else QColor("#a8f5ea")


# ----------------------------------------------------------------------------
# Glyphs for the round buttons
# ----------------------------------------------------------------------------
def draw_glyph(p, kind, c, color):
    p.save()
    p.translate(c)
    pen = QPen(color, 2.1, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin)
    p.setPen(pen)
    p.setBrush(Qt.BrushStyle.NoBrush)
    if kind == "search":
        p.drawEllipse(QPointF(-2, -2), 6, 6)
        p.drawLine(QPointF(2.5, 2.5), QPointF(7.5, 7.5))
    elif kind == "moon":
        a = QPainterPath()
        a.addEllipse(QPointF(0, 0), 8, 8)
        b = QPainterPath()
        b.addEllipse(QPointF(4.5, -3.5), 7, 7)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(color)
        p.drawPath(a.subtracted(b))
    elif kind == "sun":
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(color)
        p.drawEllipse(QPointF(0, 0), 4.2, 4.2)
        p.setPen(QPen(color, 1.9, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        for i in range(8):
            a = math.radians(i * 45)
            p.drawLine(QPointF(math.cos(a) * 6.6, math.sin(a) * 6.6),
                       QPointF(math.cos(a) * 8.8, math.sin(a) * 8.8))
    elif kind == "term":
        p.drawPolyline(QPolygonF([QPointF(-8, -5), QPointF(-3, 0), QPointF(-8, 5)]))
        p.drawLine(QPointF(1, 6), QPointF(8, 6))
    elif kind == "gear":
        p.drawEllipse(QPointF(0, 0), 5.2, 5.2)
        p.setPen(QPen(color, 3.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        for i in range(6):
            a = math.radians(i * 60)
            p.drawLine(QPointF(math.cos(a) * 6.8, math.sin(a) * 6.8),
                       QPointF(math.cos(a) * 7.8, math.sin(a) * 7.8))
    else:  # window
        p.drawRoundedRect(QRectF(-8, -6.5, 16, 13), 2.5, 2.5)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(color)
        p.drawRect(QRectF(-7.5, -6, 15, 4))
    p.restore()


class RoundButton(QWidget):
    """Round header button.
    Click animation: squishes while held, springs back with a bounce on release,
    a ring + flash ripples out of it, and the icon does its own little move
    (moon/sun spin, gear turns, the others pop + wiggle)."""
    clicked = pyqtSignal()

    def __init__(self, kind, accent, look="mode"):
        super().__init__()
        self.kind = kind
        self.accent = accent
        self.look = look            # "mode" | "theme"
        self.active = False
        self.hov = 0.0
        self.pop = 1.0
        self.press = 0.0            # 0 = idle, 1 = fully squished (mouse held down)
        self.click_t = 1.0          # 0 -> 1 click animation progress (1 = finished)
        self._down = False
        self.setFixedSize(56, 56)          # 42px circle + 7px free room on every side for the click bounce
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.anim = QVariantAnimation(self)
        self.anim.setDuration(160)
        self.anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        self.anim.valueChanged.connect(self._set_hov)

        self.press_anim = QVariantAnimation(self)
        self.press_anim.setDuration(110)
        self.press_anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        self.press_anim.valueChanged.connect(self._set_press)

        self.click_anim = QVariantAnimation(self)
        self.click_anim.setDuration(720)
        self.click_anim.setEasingCurve(QEasingCurve.Type.Linear)
        self.click_anim.setStartValue(0.0)
        self.click_anim.setEndValue(1.0)
        self.click_anim.valueChanged.connect(self._set_click)
        self.click_anim.finished.connect(self._click_done)

    def _set_hov(self, v):
        self.hov = float(v)
        self.update()

    def _set_press(self, v):
        self.press = float(v)
        self.update()

    def _set_click(self, v):
        self.click_t = float(v)
        self.update()

    def _click_done(self):
        self.click_t = 1.0
        self.update()

    def _go(self, t):
        self.anim.stop()
        self.anim.setStartValue(self.hov)
        self.anim.setEndValue(t)
        self.anim.start()

    def _press_to(self, t):
        self.press_anim.stop()
        self.press_anim.setStartValue(self.press)
        self.press_anim.setEndValue(t)
        self.press_anim.start()

    def play_click(self):
        self.click_t = 0.0
        self.click_anim.stop()
        self.click_anim.start()

    def set_active(self, a):
        newly = a and not self.active
        self.active = a
        if newly and self.isVisible():
            self.play_click()           # also bounces when activated from the keyboard (Tab)
        self.update()

    def set_kind(self, k):
        self.kind = k
        self.update()

    def set_accent(self, c):
        self.accent = c
        self.update()

    def set_pop(self, v):
        if abs(v - self.pop) > 1e-4:
            self.pop = v
            self.update()

    def enterEvent(self, e):
        self._go(1.0)

    def leaveEvent(self, e):
        self._go(0.0)

    def mousePressEvent(self, e):
        # must ACCEPT the press, otherwise Qt never delivers the release inside the tilting view
        if e.button() == Qt.MouseButton.LeftButton:
            self._down = True
            self._press_to(1.0)
            e.accept()

    def mouseReleaseEvent(self, e):
        was = self._down
        self._down = False
        self._press_to(0.0)
        if was and e.button() == Qt.MouseButton.LeftButton and self.rect().contains(e.position().toPoint()):
            self.play_click()
            self.clicked.emit()
        e.accept()

    def paintEvent(self, e):
        if self.pop <= 0.001:
            return
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing)
        p.setOpacity(clamp(self.pop * 1.6))
        ct = self.click_t
        te = ease_out_cubic(ct)
        c = QPointF(28, 28)

        # squish while held + damped spring bounce after the click
        bounce = 0.22 * math.exp(-5.5 * ct) * math.sin(ct * 15.0) if ct < 1.0 else 0.0
        s = max(0.0, self.pop) * (1 + 0.07 * self.hov) * (1 - 0.15 * self.press) * (1 + bounce)
        p.translate(c)
        p.scale(s, s)
        p.translate(-c)
        r = QRectF(7, 7, 42, 42)
        p.setPen(Qt.PenStyle.NoPen)
        if self.look == "theme":
            p.setBrush(self.accent)
            p.drawEllipse(r)
            glyph = QColor(6, 30, 28)
        else:
            p.setBrush(QColor(18, 20, 22, int(125 + 70 * self.hov + 60 * self.press)))
            p.drawEllipse(r)
            if self.active:
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(with_alpha(self.accent, 235), 2.0))
                p.drawEllipse(r.adjusted(1, 1, -1, -1))
                glyph = self.accent
            else:
                glyph = QColor(235, 245, 243)

        # ripple: a soft accent fill grows out of the centre + a thin ring expands and fades
        fade = 1 - te
        if ct < 1.0:
            p.save()
            clip = QPainterPath()
            clip.addEllipse(r)
            p.setClipPath(clip)
            flash = QColor(255, 255, 255) if self.look == "theme" else self.accent
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(with_alpha(flash, 235 * fade * fade))
            rad = 24 * ease_out_cubic(clamp(ct * 2.2))
            p.drawEllipse(c, rad, rad)
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(with_alpha(flash, 200 * fade), 2.0))
            rr = 4 + 17 * te
            p.drawEllipse(c, rr, rr)
            p.restore()
            # keep the icon readable on top of the flash: fade it to a dark colour while the fill is strong
            if self.look != "theme":
                glyph = lerp_color(glyph, SEL_TEXT, clamp(fade * fade * 1.4))

        # the icon's own motion
        angle = 0.0
        if self.kind in ("moon", "sun"):
            angle = 360.0 * te                                  # spin
        elif self.kind == "gear":
            angle = 360.0 * te                                  # turn
        elif ct < 1.0:
            angle = 16.0 * math.sin(ct * math.pi * 4) * (1 - ct)  # little wiggle
        gs = 1 + 0.28 * math.sin(math.pi * min(1.0, ct * 1.15)) if ct < 1.0 else 1.0
        p.save()
        p.translate(c)
        p.rotate(angle)
        p.scale(gs, gs)
        p.translate(-c)
        draw_glyph(p, self.kind, c, glyph)
        p.restore()


