    def restyle(self, accent):
        self.accent = QColor(accent)
        a = f"{self.accent.red()},{self.accent.green()},{self.accent.blue()}"
        self.setStyleSheet(f"""
            QLabel{{color:rgba(225,245,242,0.80);background:transparent;font-size:12px;}}
            QLabel#title{{color:white;font-size:17px;font-weight:700;}}
            QLabel#sub{{color:rgba(225,245,242,0.45);font-size:11px;padding-left:8px;}}
            QLineEdit{{background:rgba(255,255,255,0.07);border:1.5px solid rgba(255,255,255,0.12);
                      border-radius:16px;padding:0 14px;color:white;font-size:12px;
                      selection-background-color:rgba({a},0.7);selection-color:black;}}
            QLineEdit:focus{{border:1.5px solid rgba({a},0.95);}}
            QPushButton{{background:rgba(255,255,255,0.10);border:none;border-radius:16px;
                        color:white;padding:0 16px;font-size:12px;}}
            QPushButton:hover{{background:rgba(255,255,255,0.20);}}
            QPushButton#primary{{background:rgb({a});color:#04201d;font-weight:700;}}
            QPushButton#primary:hover{{background:rgba({a},0.85);}}
            QPushButton#close{{padding:0;border-radius:14px;}}
            QSlider::groove:horizontal{{height:6px;border-radius:3px;background:rgba(255,255,255,0.14);}}
            QSlider::sub-page:horizontal{{background:rgb({a});border-radius:3px;}}
            QSlider::handle:horizontal{{width:16px;height:16px;margin:-5px 0;border-radius:8px;background:white;}}
        """)
        self._mark(self.banner_edit)
        self._mark(self.bg_edit)
        self.update()

    def _mark(self, edit):
        t = clean_path(edit.text())
        if not t:
            col = "rgba(255,255,255,0.12)"
        elif valid_image(t):
            col = f"rgba({self.accent.red()},{self.accent.green()},{self.accent.blue()},0.9)"
        else:
            col = "rgba(255,110,110,0.95)"
        edit.setStyleSheet(f"QLineEdit{{border:1.5px solid {col};}}")

    def _browse(self, edit):
        start = os.path.dirname(resolve_path(edit.text())) if edit.text().strip() else str(Path.home() / "Pictures")
        try:
            path, _ = QFileDialog.getOpenFileName(
                QApplication.activeWindow(), "Choose an image", start,
                "Images (*.png *.jpg *.jpeg *.webp *.bmp *.gif);;All files (*)")
        except Exception:
            path = ""
        if path:
            edit.setText(os.path.normpath(path))

    # --- values ------------------------------------------------------------
    def refresh_from_cfg(self):
        self._loading = True
        self.banner_edit.setText(CFG["banner_image"])
        self.bg_edit.setText(CFG["background_image"])
        self.blur.setValue(int(CFG["background_blur"]))
        self.focus.setValue(int(round(float(CFG["banner_focus_y"]) * 100)))
        self.tilt.setValue(int(round(float(CFG["max_tilt"]))))
        self.dim.setValue(int(CFG["background_dim"]))
        self.accent_edit.setText(str(CFG["accent"]))
        self.folders_edit.setText("; ".join(CFG["extra_roots"]))
        self._mark(self.banner_edit)
        self._mark(self.bg_edit)
        self._loading = False

    def _queue(self, *_):
        if not self._loading:
            self.status.setText("\u2026")
            self.debounce.start()

    def _apply_live(self):
        changed = set()

        def put(key, val, tag):
            if CFG.get(key) != val:
                CFG[key] = val
                changed.add(tag)

        bi = clean_path(self.banner_edit.text())
        if not bi or valid_image(bi):
            put("banner_image", bi, "banner")
        bg = clean_path(self.bg_edit.text())
        if not bg or valid_image(bg):
            put("background_image", bg, "bg")
        put("banner_focus_y", round(self.focus.value() / 100.0, 2), "banner")
        put("background_blur", self.blur.value(), "bg")
        put("background_dim", self.dim.value(), "bg")
        put("max_tilt", float(self.tilt.value()), "tilt")
        ac = self.accent_edit.text().strip()
        if ac.lower() == "auto" or (ac and QColor(ac).isValid()):
            put("accent", ac, "accent")
        roots = [s.strip().strip('"') for s in self.folders_edit.text().split(";") if s.strip()]
        put("extra_roots", roots, "roots")
        bad = (bi and not valid_image(bi)) or (bg and not valid_image(bg))
        if changed:
            save_config()
            self.changed.emit(changed)
        self.status.setText("\u2717 image not found" if bad else ("\u2713 applied" if changed else "\u2713 saved"))

    def _reset(self):
        for k in ("banner_image", "background_image", "background_blur", "background_dim",
                  "banner_focus_y", "accent", "max_tilt", "extra_roots"):
            CFG[k] = list(DEFAULT_CFG[k]) if isinstance(DEFAULT_CFG[k], list) else DEFAULT_CFG[k]
        save_config()
        self.refresh_from_cfg()
        self.changed.emit({"banner", "bg", "accent", "tilt", "roots"})
        self.status.setText("\u2713 reset to defaults")

    # --- open / close ------------------------------------------------------
    def _slide(self, v):
        self.move(14, int(self.base_y + (1 - float(v)) * (self.H + 30)))

    def _anim_done(self):
        if self.closing:
            self.hide()
            self.closed.emit()

    def is_open(self):
        return self.isVisible() and not self.closing

    def open_anim(self):
        if self.is_open():
            return
        self.refresh_from_cfg()
        self.status.setText("")
        self.closing = False
        self.anim.stop()
        c = QEasingCurve(QEasingCurve.Type.OutBack)
        c.setOvershoot(1.15)
        self.anim.setEasingCurve(c)
        self.anim.setDuration(560)
        self.anim.setStartValue(0.0)
        self.anim.setEndValue(1.0)
        self.move(14, CARD_H)
        self.show()
        self.raise_()
        self.anim.start()

    def close_anim(self):
        if not self.isVisible() or self.closing:
            return
        self._apply_live() if self.debounce.isActive() else None
        self.debounce.stop()
        self.closing = True
        self.anim.stop()
        self.anim.setEasingCurve(QEasingCurve.Type.InCubic)
        self.anim.setDuration(260)
        self.anim.setStartValue(1.0)
        self.anim.setEndValue(0.0)
        self.anim.start()

    def toggle(self):
        if self.is_open():
            self.close_anim()
        else:
            self.open_anim()

    def keyPressEvent(self, e):
        if e.key() == Qt.Key.Key_Escape:
            self.close_anim()
            e.accept()
            return
        super().keyPressEvent(e)

    def paintEvent(self, e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        path = QPainterPath()
        path.addRoundedRect(r, 24, 24)
        g = QLinearGradient(r.topLeft(), r.bottomLeft())
        g.setColorAt(0, QColor(20, 30, 32, 250))
        g.setColorAt(1, QColor(8, 14, 15, 252))
        p.fillPath(path, g)
        p.setPen(QPen(QColor(255, 255, 255, 36), 1.2))
        p.drawPath(path)
        p.setPen(QPen(with_alpha(self.accent, 170), 2.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        p.drawLine(QPointF(34, 1.6), QPointF(r.width() - 34, 1.6))


