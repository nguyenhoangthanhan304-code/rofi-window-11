class ColorDot(QWidget):
    clicked = pyqtSignal(str)

    def __init__(self, value):
        super().__init__()
        self.value = value
        self.hov = False
        self.setFixedSize(26, 26)
        self.setCursor(Qt.CursorShape.PointingHandCursor)

    def enterEvent(self, e):
        self.hov = True
        self.update()

    def leaveEvent(self, e):
        self.hov = False
        self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._down = True
            e.accept()

    def mouseReleaseEvent(self, e):
        was = getattr(self, "_down", False)
        self._down = False
        if was and e.button() == Qt.MouseButton.LeftButton:
            self.clicked.emit(self.value)
        e.accept()

    def paintEvent(self, e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(3, 3, 20, 20)
        if self.value == "auto":
            g = QConicalGradient(r.center(), 0)
            for i, c in enumerate(("#ff6b6b", "#ffd93d", "#6bff95", "#4dd8ff", "#b58bff", "#ff6b6b")):
                g.setColorAt(i / 5.0, QColor(c))
            p.setBrush(g)
        else:
            p.setBrush(QColor(self.value))
        p.setPen(QPen(QColor(255, 255, 255, 230 if self.hov else 70), 1.8))
        p.drawEllipse(r)


