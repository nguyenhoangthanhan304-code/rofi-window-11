_SKIP_APP_RE = re.compile(r"uninstall|readme|release notes|license|documentation|\bhelp\b", re.I)
START_EXTS = (".lnk", ".url", ".appref-ms")      # .url = Steam games etc, .appref-ms = ClickOnce apps


def make_start_app(name, appid):
    """An app that is launched through the shell's AppsFolder (Store / UWP apps and friends)."""
    return App(name, "shell:AppsFolder\\" + appid,
               category="Store app" if "!" in appid else "Application")


def load_start_apps_cache():
    try:
        data = json.loads(APPS_CACHE.read_text("utf-8"))
        return [(str(n), str(i)) for n, i in data]
    except Exception:
        return []


def discover_apps():
    apps = {}
    try:
        if sys.platform.startswith("win"):
            roots = [
                Path(os.environ.get("ProgramData", "C:/ProgramData")) / "Microsoft/Windows/Start Menu/Programs",
                Path(os.environ.get("APPDATA", "")) / "Microsoft/Windows/Start Menu/Programs",
            ]
            for root in roots:
                if not root.exists():
                    continue
                base = os.path.normpath(str(root))
                for dirpath, _dirs, files in os.walk(str(root)):
                    cat = "Application" if os.path.normpath(dirpath) == base else os.path.basename(dirpath)
                    for fn in files:
                        stem, ext = os.path.splitext(fn)
                        if ext.lower() not in START_EXTS or _SKIP_APP_RE.search(stem):
                            continue
                        apps.setdefault(stem.lower(), App(stem, os.path.join(dirpath, fn), category=cat))
            # Store / UWP apps from the last background scan (AppScanner refreshes this list)
            for name, appid in load_start_apps_cache():
                if not _SKIP_APP_RE.search(name) and name.lower() not in apps:
                    apps[name.lower()] = make_start_app(name, appid)
        elif sys.platform == "darwin":
            dirs = ["/Applications", "/Applications/Utilities", "/System/Applications",
                    "/System/Applications/Utilities", str(Path.home() / "Applications")]
            for d in dirs:
                p = Path(d)
                if not p.exists():
                    continue
                for f in p.glob("*.app"):
                    apps.setdefault(f.stem.lower(), App(f.stem, str(f), category=p.name or "Application"))
        else:
            dirs = ["/usr/share/applications", "/usr/local/share/applications",
                    str(Path.home() / ".local/share/applications"),
                    "/var/lib/flatpak/exports/share/applications",
                    str(Path.home() / ".local/share/flatpak/exports/share/applications")]
            loc = QLocale().name()
            lang = loc.split("_")[0]
            for d in dirs:
                p = Path(d)
                if not p.exists():
                    continue
                for f in p.glob("*.desktop"):
                    cp = configparser.ConfigParser(interpolation=None, strict=False)
                    try:
                        cp.read(f, encoding="utf-8")
                        e = cp["Desktop Entry"]
                    except Exception:
                        continue
                    if e.get("NoDisplay", "false").lower() == "true" or e.get("Hidden", "false").lower() == "true":
                        continue
                    if e.get("Type", "Application") != "Application" or "Exec" not in e:
                        continue
                    name = e.get(f"Name[{loc}]") or e.get(f"Name[{lang}]") or e.get("Name", f.stem)
                    desc = e.get(f"Comment[{loc}]") or e.get(f"Comment[{lang}]") or e.get("Comment", "")
                    cats = [c for c in e.get("Categories", "").split(";") if c]
                    apps.setdefault(name.lower(), App(name, e["Exec"], desc,
                                                      cats[0] if cats else "Application",
                                                      e.get("Icon")))
    except Exception as ex:
        print("App discovery problem:", ex)
    return sorted(apps.values(), key=lambda a: a.name.casefold())


class AppScanner(QThread):
    """Windows only: asks Windows itself for the full 'All apps' list (Get-StartApps) in the background,
    so Store / UWP apps (Calculator, Photos, Settings, Xbox ...) show up too."""
    found = pyqtSignal(object)          # [(name, appid), ...]
    PS = ("[Console]::OutputEncoding = New-Object System.Text.UTF8Encoding $false; "
          "Get-StartApps | Select-Object Name,AppID | ConvertTo-Json -Compress")

    def __init__(self):
        super().__init__()
        self._proc = None
        self._stop = False

    def stop(self):
        self._stop = True
        try:
            if self._proc is not None and self._proc.poll() is None:
                self._proc.kill()
        except Exception:
            pass

    def run(self):
        try:
            self._proc = subprocess.Popen(
                ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                 "-Command", self.PS],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                creationflags=0x08000000)                       # CREATE_NO_WINDOW
            out, _ = self._proc.communicate(timeout=60)
            if self._stop:
                return
            text = out.decode("utf-8-sig", "replace").strip()
            if not text:
                return
            data = json.loads(text)
            if isinstance(data, dict):
                data = [data]
            found = []
            for d in data:
                if isinstance(d, dict):
                    n, i = str(d.get("Name") or "").strip(), str(d.get("AppID") or "").strip()
                    if n and i:
                        found.append((n, i))
            if not found:
                return
            try:
                CONFIG_DIR.mkdir(parents=True, exist_ok=True)
                APPS_CACHE.write_text(json.dumps(found), "utf-8")
            except Exception:
                pass
            self.found.emit(found)
        except Exception as ex:
            print("Start-apps scan failed:", ex)


def launch_app(app):
    try:
        if sys.platform.startswith("win"):
            if app.command.lower().startswith("shell:"):
                subprocess.Popen(["explorer.exe", app.command])
            else:
                os.startfile(app.command)  # noqa
        elif sys.platform == "darwin":
            subprocess.Popen(["open", app.command])
        else:
            cmd = re.sub(r"%[a-zA-Z%]", "", app.command).strip()
            subprocess.Popen(shlex.split(cmd), start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as ex:
        print("Launch failed:", ex)


